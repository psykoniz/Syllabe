{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "outDir": "dist-types",
    "noEmit": true
  },
  "include": ["src/**/*", "vite.config.ts", "server.ts"],
  "exclude": ["node_modules", "dist"]
}
